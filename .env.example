# Copy to .env and adjust. docker compose reads .env automatically.
# Every variable below has a working default in docker-compose.yml, so
# `docker compose up` works on a bare machine without this file.

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=pcpartlister
POSTGRES_PASSWORD=pcpartlister
POSTGRES_DB=pcpartlister
# Host port Postgres is published on, bound to 127.0.0.1 only. Used by
# `npm run db:studio` and by a dev server running outside Docker.
POSTGRES_PORT=5432
# Only needed when running the app outside Docker (host = localhost).
# Inside compose the app builds this itself and points at the `db` service.
DATABASE_URL=postgres://pcpartlister:pcpartlister@localhost:5432/pcpartlister

# ── Sessions ──────────────────────────────────────────────────────────
# 32+ characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-32chars
# Session lifetime in hours (336 = 14 days).
SESSION_TTL_HOURS=336
# true when the app is served over HTTPS (reverse proxy). MUST be false for
# plain http://, otherwise the browser drops the session cookie and login
# silently fails.
COOKIE_SECURE=false

# ── Initial admin account (created at seed only, when the users table is empty)
ADMIN_EMAIL=admin@pcpartlister.local
ADMIN_PASSWORD=changeme123

# ── Runtime ───────────────────────────────────────────────────────────
# Host port the app is published on.
PORT=3000
# Where component pictures are stored (Docker named volume).
IMAGES_DIR=/app/data/images
# Where the hand-editable catalog seed JSON lives.
SEED_DATA_DIR=/app/data/seed
# Where the hand-editable GPU ranking CSV lives.
TIER_LIST_DATA_DIR=/app/data/tier-list
